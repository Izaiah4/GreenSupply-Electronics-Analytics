        <aliases>
          <alias key='&quot;[federated.0iywdm60e6kgeg12x49hc13iqium].[avg:Estimated Transport Emissions (kg CO₂e):qk]&quot;' value='Avg Emissions' />
          <alias key='&quot;[federated.0iywdm60e6kgeg12x49hc13iqium].[sum:Estimated Transport Emissions (kg CO₂e):qk]&quot;' value='Average kg CO₂e' />
