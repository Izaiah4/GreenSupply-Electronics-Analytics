      <column datatype='integer' name='[Avg Inventory Units]' role='measure' type='quantitative' />
      <column caption='Avg Inventory Units1' datatype='integer' name='[Avg_Inventory_Units]' role='measure' type='quantitative' />
      <column datatype='real' name='[COGS Recalculated]' role='measure' type='quantitative' />
      <column caption='Emission Per Order' datatype='real' name='[Calculation_0446677713072128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Estimated Transport Emissions (kg CO₂e)])/SUM([Sales Quantity])' />
      </column>
      <column caption='Return Rate to Sales Quantity' datatype='real' default-format='p0.00%' name='[Calculation_0446677722677249]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Sales Quantity]) = 0 THEN 0&#13;&#10;ELSE&#13;&#10;    SUM([Returned Quantity]) / SUM([Sales Quantity])&#13;&#10;END' />
      </column>
      <column caption='Shipping Cost To Revenue' datatype='real' name='[Calculation_0446677723394050]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Shipping Cost (€)])/SUM([Revenue (€)])' />
      </column>
      <column caption='Profit Margin %' datatype='real' default-format='p0.00%' name='[Calculation_0446677892325379]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit Recalculated])/SUM([Revenue (€)])' />
      </column>
      <column caption='Gross Profit' datatype='real' default-format='C6153%' name='[Calculation_0923866583142400]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Revenue (€)])-SUM([COGS Recalculated])' />
      </column>
      <column caption='COGS to Revenue Ratio' datatype='real' default-format='p0.00%' name='[Calculation_0923866593361921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([COGS Recalculated])/SUM([Revenue (€)])' />
      </column>
      <column caption='Gross Profit Margin' datatype='real' default-format='p0.00%' name='[Calculation_0923866597371906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Revenue (€)])-SUM([COGS Recalculated]))/SUM([Revenue (€)])' />
      </column>
      <column caption='Average COGS per Unit' datatype='real' default-format='C6153%' name='[Calculation_0923866598637571]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Sales Quantity]) = 0 THEN NULL&#13;&#10;ELSE&#13;&#10;    SUM([COGS Recalculated]) / SUM([Sales Quantity])&#13;&#10;END' />
      </column>
      <column caption='Total Revenue' datatype='real' name='[Calculation_0923866603917316]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Revenue (€)])' />
      </column>
      <column caption='Total COGS' datatype='real' name='[Calculation_0923866603999237]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([COGS Recalculated])' />
      </column>
      <column caption='Delivery Status' datatype='string' name='[Calculation_1349377198481408]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Actual Delivery Date] &lt;= [Promised Delivery Date])THEN &quot;On Time&quot; ELSE &quot;Late&quot; END' />
      </column>
      <column caption='On Time Orders' datatype='integer' name='[Calculation_1349377199865857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Calculation_1349377198481408] = &quot;On Time&quot;&#13;&#10;    THEN [Order ID]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Valid Delivered Orders' datatype='integer' name='[Calculation_1349377200398338]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Order ID])' />
      </column>
      <column caption='On-Time Delivery Rate' datatype='real' default-format='p0.00%' name='[Calculation_1349377200537603]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1349377199865857] / [Calculation_1349377200398338]' />
      </column>
      <column caption='Total Costs' datatype='real' name='[Calculation_1349377207873540]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Holding Cost Recalculated]+[Shipping Cost (€)]+[COGS Recalculated]' />
      </column>
      <column caption='Delivery Delay Days' datatype='integer' name='[Calculation_2285610344398848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&#13;&#10;    &apos;day&apos;,&#13;&#10;    [Promised Delivery Date],&#13;&#10;    [Actual Delivery Date]&#13;&#10;)' />
      </column>
      <column caption='Profit Margin' datatype='real' name='[Calculation_2285610351427585]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Profit Recalculated]/[Revenue (€)]' />
      </column>
      <column caption='Delivery Days' datatype='integer' name='[Calculation_2764173858037761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&#13;&#10;    &apos;day&apos;,[Shipment Date],&#13;&#10;    [Actual Delivery Date]&#13;&#10;&#13;&#10;)' />
      </column>
      <column caption='Late/Delayed Orders' datatype='integer' name='[Calculation_2764173860634626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Calculation_1349377198481408] = &quot;Late&quot;&#13;&#10;    THEN [Order ID]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Late Delivery Rate' datatype='real' name='[Calculation_2764173860884483]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2764173860634626]/ [Calculation_1349377200398338]' />
      </column>
      <column caption='Transport Damage Order' datatype='integer' name='[Calculation_2764173868064772]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF[Return Reason] = &apos;Damaged in transit&apos; THEN [Order ID]END)' />
      </column>
      <column caption='Total Orders' datatype='integer' name='[Calculation_3126738187005952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Order ID])' />
      </column>
