    <worksheet name='KPI&apos;S'>
      <table>
        <view>
          <datasources>
            <datasource caption='Orders+ (GreenSupplyData Cleaned)' name='federated.0iywdm60e6kgeg12x49hc13iqium' />
          </datasources>
          <datasource-dependencies datasource='federated.0iywdm60e6kgeg12x49hc13iqium'>
            <column datatype='date' name='[Actual Delivery Date]' role='dimension' type='ordinal' />
            <column datatype='real' name='[COGS Recalculated]' role='measure' type='quantitative' />
            <column caption='Return Rate to Sales Quantity' datatype='real' default-format='p0.00%' name='[Calculation_0446677722677249]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Sales Quantity]) = 0 THEN 0&#13;&#10;ELSE&#13;&#10;    SUM([Returned Quantity]) / SUM([Sales Quantity])&#13;&#10;END' />
            </column>
            <column caption='Profit Margin %' datatype='real' default-format='p0.00%' name='[Calculation_0446677892325379]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Profit Recalculated])/SUM([Revenue (€)])' />
            </column>
            <column caption='Gross Profit' datatype='real' default-format='C6153%' name='[Calculation_0923866583142400]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Revenue (€)])-SUM([COGS Recalculated])' />
            </column>
            <column caption='COGS to Revenue Ratio' datatype='real' default-format='p0.00%' name='[Calculation_0923866593361921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([COGS Recalculated])/SUM([Revenue (€)])' />
            </column>
            <column caption='Gross Profit Margin' datatype='real' default-format='p0.00%' name='[Calculation_0923866597371906]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Revenue (€)])-SUM([COGS Recalculated]))/SUM([Revenue (€)])' />
            </column>
            <column caption='Average COGS per Unit' datatype='real' default-format='C6153%' name='[Calculation_0923866598637571]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Sales Quantity]) = 0 THEN NULL&#13;&#10;ELSE&#13;&#10;    SUM([COGS Recalculated]) / SUM([Sales Quantity])&#13;&#10;END' />
            </column>
            <column caption='Total Revenue' datatype='real' name='[Calculation_0923866603917316]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Revenue (€)])' />
            </column>
            <column caption='Delivery Status' datatype='string' name='[Calculation_1349377198481408]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Actual Delivery Date] &lt;= [Promised Delivery Date])THEN &quot;On Time&quot; ELSE &quot;Late&quot; END' />
            </column>
            <column caption='On Time Orders' datatype='integer' name='[Calculation_1349377199865857]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Calculation_1349377198481408] = &quot;On Time&quot;&#13;&#10;    THEN [Order ID]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Valid Delivered Orders' datatype='integer' name='[Calculation_1349377200398338]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Order ID])' />
            </column>
            <column caption='On-Time Delivery Rate' datatype='real' default-format='p0.00%' name='[Calculation_1349377200537603]' role='measure' type='quantitative'>
